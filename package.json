{
  "name": "blindhire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BlindHire - Privacy-preserving candidate screening dApp on Midnight Network. Qualified before identified.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "node scripts/compile.cjs && node scripts/copy-managed.cjs",
    "test": "vitest run src/test/circuits.unit.test.ts",
    "test:integration": "cross-env NODE_OPTIONS='--experimental-vm-modules' vitest run src/test/blindhire.test.ts",
    "test:local": "cross-env MIDNIGHT_NETWORK=local yarn test:integration",
    "test:preview": "cross-env MIDNIGHT_NETWORK=preview yarn test:integration",
    "test:preprod": "cross-env MIDNIGHT_NETWORK=preprod yarn test:integration",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "copy:managed": "node scripts/copy-managed.cjs"
  }
}
