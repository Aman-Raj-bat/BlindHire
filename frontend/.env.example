# BlindHire Frontend Environment Variables

# Preprod Smart Contract Address (64-char hex)
VITE_PREPROD_CONTRACT_ADDRESS=

# Midnight Network identifier: 'preprod', 'preview', or 'local'
VITE_MIDNIGHT_NETWORK=preprod

# Optional custom GraphQL indexer endpoint override
VITE_INDEXER_URI=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
