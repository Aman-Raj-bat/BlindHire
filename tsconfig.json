{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "contracts/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "frontend"]
}
